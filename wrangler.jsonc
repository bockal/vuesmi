{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vuesmi",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "GA_MEASUREMENT_ID": "G-H6N4PTB97N",  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vuesmi-production",
      "database_id": "2d6a80ea-5a83-4c45-a637-e463d5dec995",
      "migrations_dir": "drizzle"
    }
  ]
}
